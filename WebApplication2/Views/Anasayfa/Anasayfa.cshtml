
@{
    ViewBag.Title = "Anasayfa";
    Layout = "~/Views/Shared/AnasayfaLayout.cshtml";
}


@using WebApplication2;

@model WebApplication2.MyViewModel
<main>

    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="row">
                    <div class="col-sm-6 col-lg-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    @*<div class="subheader">Sales</div>*@
                                    <div class="ms-auto lh-1">
                                        <div class="dropdown">
                                            <a class="dropdown-toggle text-muted" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Son 7 Gün</a>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <a class="dropdown-item active" href="#">Son 7 Gün</a>
                                                <a class="dropdown-item" href="#">Son 30 Gün</a>
                                                <a class="dropdown-item" href="#">Son 3 Ay</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="h1 mb-3">100%</div>
                                <div class="d-flex mb-2">
                                    <div>Yüzdelik Oran</div>
                                    <div class="ms-auto">
                                        <span class="text-green d-inline-flex align-items-center lh-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon ms-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                <path d="M3 17l6 -6l4 4l8 -8"></path>
                                                <path d="M14 7l7 0l0 7"></path>
                                            </svg>
                                        </span>
                                    </div>
                                </div>
                                @foreach (var item in Model.TBL_Kasa)
                                {
                                    double value = item.net_gelir.HasValue ? (double)item.net_gelir.Value : 0.0;
                                    double net_gelir = Math.Min((value / 100000) * 100, 100);
                                    <div class="progress progress-sm">
                                        <div class="progress-bar bg-primary" style="width: @net_gelir%" role="progressbar" aria-valuenow="@net_gelir" aria-valuemin="0" aria-valuemax="100" aria-label="@net_gelir% Complete">
                                            <span class="visually-hidden">@net_gelir% Complete</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="subheader" style="font-size:1.2rem">Bugün</div>

                                </div>
                                <script>
                                    document.addEventListener("DOMContentLoaded", function () {
                                        var today = new Date();
                                        var date = today.toLocaleDateString();
                                        document.getElementById("current-date").textContent = date;
                                    });
                                </script>
                                <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.5.0/font/bootstrap-icons.min.css" rel="stylesheet">
                                <div class="d-flex align-items-baseline">
                                    <div class="h1 mt-5 mb-2 me-2">
                                        <p id="current-date" style="font-size:2.2rem"></p>
                                    </div>
                                    <div class="me-auto">

                                        <span class="text-green d-inline-flex align-items-center lh-1">
                                        </span>
                                    </div>
                                    <i class="bi bi-calendar3 d-flex justify-content-end" style="font-size: 4rem;"></i>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-body">
                            <h3 class="card-title">Aylık Kira Takibi</h3>
                            <div class="d-flex align-items-center">
                                <table class="table">
                                    <tr class="bg-azure-lt">
                                        <th style="color:darkblue;">EV SAHİBİ ADI</th>
                                        <th style="color: darkblue;">OCAK</th>
                                        <th style="color: darkblue;">ŞUBAT</th>
                                        <th style="color: darkblue;">MART</th>
                                        <th style="color: darkblue;">NİSAN</th>
                                        <th style="color: darkblue;">MAYIS</th>
                                        <th style="color: darkblue;">HAZİRAN</th>
                                        <th style="color: darkblue;">TEMMUZ</th>
                                        <th style="color: darkblue;">AGUSTOS</th>
                                        <th style="color: darkblue;">EYLÜL</th>
                                        <th style="color: darkblue;">EKİM</th>
                                        <th style="color: darkblue;">KASIM</th>
                                        <th style="color: darkblue;">ARALIK</th>


                                    </tr>
                                    <tbody>


                                        @foreach (var ktgr in Model.TBL_Aylikgelir)
                                        { 
                                            <tr class="bg-blue-lt">
                                                <td style="color:black;"><b>@ktgr.TBL_evsahibi.konuts_ad @ktgr.TBL_evsahibi.konuts_soyad </b></td> 
                                                <td style="color:black;"><b>@ktgr.Ocak </b></td>
                                                <td style="color:black;"><b>@ktgr.Subat </b></td>
                                                <td style="color:black;"><b>@ktgr.Mart </b></td>
                                                <td style="color:black;"><b>@ktgr.Nisan </b></td>
                                                <td style="color:black;"><b>@ktgr.Mayis </b></td>
                                                <td style="color:black;"><b>@ktgr.Haziran </b></td>
                                                <td style="color:black;"><b>@ktgr.Temmuz</b></td>
                                                <td style="color:black;"><b>@ktgr.Agustos</b></td>
                                                <td style="color:black;"><b>@ktgr.Eylul</b></td>
                                                <td style="color:black;"><b>@ktgr.Ekim </b></td>
                                                <td style="color:black;"><b>@ktgr.Kasim </b></td>
                                                <td style="color:black;"><b>@ktgr.Aralik</b></td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @*******GRAFİK KODU*******@


