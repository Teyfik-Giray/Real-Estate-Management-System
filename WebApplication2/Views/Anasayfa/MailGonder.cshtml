@{
    ViewBag.Title = "MailGonder";
    Layout = "~/Views/Shared/AnasayfaLayout.cshtml";
}

@model WebApplication2.Models.Email

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="container">
        <div class="form-horizontal">
            <br />
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info">@TempData["Message"]</div>
            }

            <div class="form-group row mb-3">
                @Html.LabelFor(model => model.AdSoyad, htmlAttributes: new { @class = "col-form-label col-md-2 col-12" })
                <div class="col-md-10 col-12">
                    @Html.TextBoxFor(model => model.AdSoyad, new { @class = "form-control", @placeholder = "Ad Soyad" })
                    @Html.ValidationMessageFor(model => model.AdSoyad, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group row mb-3">
                @Html.LabelFor(model => model.Baslik, htmlAttributes: new { @class = "col-form-label col-md-2 col-12" })
                <div class="col-md-10 col-12">
                    @Html.TextBoxFor(model => model.Baslik, new { @class = "form-control", @placeholder = "Başlık" })
                    @Html.ValidationMessageFor(model => model.Baslik, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group row mb-3">
                @Html.LabelFor(model => model.İcerik, htmlAttributes: new { @class = "col-form-label col-md-2 col-12" })
                <div class="col-md-10 col-12">
                    @Html.TextAreaFor(model => model.İcerik, new { @class = "form-control", @rows = "6", @maxlength = "3000", @placeholder = "İçerik" })
                    @Html.ValidationMessageFor(model => model.İcerik, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-10 col-12 offset-md-2 text-end">
                    <input type="submit" value="Gönder" class="btn btn-default btn-lg" style="background-color: #ADD8E6; color: white; width: 150px;" />
                </div>
            </div>
        </div>
    </div>
}


<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
