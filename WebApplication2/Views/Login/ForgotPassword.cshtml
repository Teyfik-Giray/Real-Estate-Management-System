@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Şifremi Unuttum</title>
    <!-- CSS files -->
    <link href="~/demo/dist/css/tabler.min.css" rel="stylesheet" />
    <link href="~/demo/dist/css/tabler-flags.min.css?1684106062" rel="stylesheet" />
    <link href="~/demo/dist/css/tabler-payments.min.css?1684106062" rel="stylesheet" />
    <link href="~/demo/dist/css/tabler-vendors.min.css?1684106062" rel="stylesheet" />
    <link href="~/demo/dist/css/demo.min.css?1684106062" rel="stylesheet" />
    <link href="https://rsms.me/inter/inter.css" rel="stylesheet" />
</head>
<body class=" d-flex flex-column">
    <script src="~/demo/dist/js/demo-theme.min.js?1684106062"></script>
    <div class="page page-center">
        <div class="container container-normal py-4">
            <div class="row align-items-center g-4">
                <div class="col-lg">
                    <div class="container-tight">
                        <div class="text-center mb-4">
                            <a href="." class="navbar-brand navbar-brand-autodark">
                                <img src="~/demo/static/logo.svg" height="36" alt="">
                            </a>
                        </div>
                        <div class="card card-md">
                            <div class="card-body">
                                <h2 class="h2 text-center mb-4">Şifrenizi Sıfırlayın</h2>
                                @if (!string.IsNullOrEmpty(ViewBag.Message))
                                {
                                    <div class="alert @(ViewBag.Success ? "alert-success" : "alert-danger")" role="alert">
                                        @ViewBag.Message
                                    </div>
                                    if (ViewBag.Success)
                                    {
                                        <script>
                                            setTimeout(function() {
                                                window.location.href = '@Url.Action("Login", "Login")';
                                            }, 5000);
                                        </script>
                                    }
                                }
                                @using (Html.BeginForm("ForgotPassword", "Login", FormMethod.Post))
                                {
                                    <div class="mb-3">
                                        <label class="form-label">Kullanıcı Adı</label>
                                        <input name="Admin_ad" type="text" class="form-control" placeholder="Kullanıcı Adı" autocomplete="off">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Yeni Şifre</label>
                                        <input name="Admin_sifre" type="password" class="form-control" placeholder="Yeni Şifre" autocomplete="off">
                                    </div>
                                    <div class="form-footer">
                                        <button type="submit" class="btn btn-primary w-100">Şifreyi Sıfırla</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg d-none d-lg-block">
                    <img src="~/demo/static/illustrations/undraw_secure_login_pdn4.svg" height="300" class="d-block mx-auto" alt="">
                </div>
            </div>
        </div>
    </div>
</body>
</html>
