@model WebApplication2.TBL_konutturu

@{
    ViewBag.Title = "UrunGetir";
    Layout = "~/Views/Shared/AnasayfaLayout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f7f7f7;
        }

        .form-container {
            background-color: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            max-width: 600px;
            margin: 50px auto;
        }

            .form-container h2 {
                margin-bottom: 20px;
                color: darkblue;
            }

        .form-group {
            margin-bottom: 20px;
        }

        button[type="submit"] {
            width: 100%;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            display: flex;
        }

        .modal-content {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
            width: 80%;
            max-width: 400px;
            text-align: center;
            position: relative;
        }

        .close {
            color: #aaa;
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 28px;
            font-weight: bold;
        }

            .close:hover,
            .close:focus {
                color: black;
                text-decoration: none;
                cursor: pointer;
            }

        .modal-message {
            font-size: 18px;
            color: #333;
        }
    </style>
</head>
<body>

    <div class="form-container">
        <h6>Bu sayfada konut güncelleme işlemini gerçekleştirmektesiniz...</h6>
        <br />
        @using (Html.BeginForm("Guncelle", "VeriIslemleri", FormMethod.Post, new { id = "updateForm" }))
        {
            @Html.HiddenFor(m => m.tur_id) <!-- konut_id değerini saklamak için gizli alan -->

            <div class="form-group">
               <label style="color:darkblue">Tür Adı</label>
                @Html.DropDownListFor(m => m.konuttur_ad, new SelectList(new List<string> { "Daire", "Ofis", "Müstakil Ev", "Villa", "Diğer" }, Model.konuttur_ad), new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label style="color:darkblue">Oda Sayısı</label>
                @Html.TextBoxFor(m => m.oda_sayısı, new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label style="color:darkblue">Metrekare Bilgisi</label>
                @Html.TextBoxFor(m => m.metre_kare, new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label style="color:darkblue">Konut Adresi</label>
                @Html.TextBoxFor(m => m.adres, new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label style="color:darkblue">Isınma Türü</label>
                @Html.DropDownListFor(m => m.ısınma_turu, new SelectList(new List<string> { "Doğal Gaz", "Klima", "Soba", "Diğer" }, Model.ısınma_turu), new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label style="color:darkblue">Eşyalı Mı ?</label>
                @Html.DropDownListFor(m => m.esyalimi, new SelectList(new List<string> { "Evet", "Hayır" }, Model.esyalimi), new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label style="color:darkblue">Konut Durumu</label>
                @Html.DropDownListFor(m => m.gayrimenkul_durum, new SelectList(new List<string> { "Satılık", "Kiralık" }, Model.gayrimenkul_durum), new { @class = "form-control" })
            </div>

            <button class="btn btn-warning" type="submit">Güncelle</button>
        }

        <!-- The Modal -->
        <div id="myModal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal()">&times;</span>
                <p class="modal-message">Tüm alanlar doldurulmalıdır!</p>
            </div>
        </div>

        <!-- Update Confirmation Modal -->
        <div id="updateModal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeUpdateModal()">&times;</span>
                <p class="modal-message">Verileriniz güncellendi!</p>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
    <script>
        $(document).ready(function () {
            var modal = document.getElementById("myModal");
            var updateModal = document.getElementById("updateModal");

            // Modal açılışlarını gizle
            modal.style.display = "none";
            updateModal.style.display = "none";

            document.getElementById("updateForm").onsubmit = function (e) {
                e.preventDefault();
                if (validateForm()) {
                    $.ajax({
                        url: '@Url.Action("Guncelle", "VeriIslemleri")',
                        type: 'POST',
                        data: $(this).serialize(),
                        success: function (response) {
                            if (response.success) {
                                updateModal.style.display = "flex";
                                setTimeout(function () {
                                    window.location.href = '@Url.Action("GayrimenkulIslemler", "Anasayfa")';
                                }, 2000); // 2 saniye sonra yönlendir
                            } else {
                                alert(response.message || "Güncelleme başarısız oldu.");
                            }
                        },
                        error: function () {
                            alert("Bir hata oluştu.");
                        }
                    });
                } else {
                    modal.style.display = "flex";
                }
            };

            function validateForm() {
                var konuttur_ad = document.forms[0]["konuttur_ad"].value;
                var oda_sayısı = document.forms[0]["oda_sayısı"].value;
                var metre_kare = document.forms[0]["metre_kare"].value;
                var adres = document.forms[0]["adres"].value;
                var ısınma_turu = document.forms[0]["ısınma_turu"].value;
                var esyalimi = document.forms[0]["esyalimi"].value;
                var gayrimenkul_durum = document.forms[0]["gayrimenkul_durum"].value;

                if (konuttur_ad === "" || oda_sayısı === "" || metre_kare === "" || adres === "" || ısınma_turu === "" || esyalimi === "" || gayrimenkul_durum === "") {
                    return false;
                }

                return true;
            }

            function closeModal() {
                modal.style.display = "none";
            }

            function closeUpdateModal() {
                updateModal.style.display = "none";
            }

            window.onclick = function (event) {
                if (event.target === modal) {
                    modal.style.display = "none";
                }
                if (event.target === updateModal) {
                    updateModal.style.display = "none";
                }
            }
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>
